# Optional overrides for docker-compose.yml. Copy to .env and edit only if you
# need to change a default — the compose file works out of the box without it.
#
# SEED_ADDR is the seed node's dial address on the compose network. Its Peer ID
# comes from the committed dev-only key deploy/seed.key, so it is fixed; the
# value below is already the compose default. Override it only if you regenerate
# that key (its Peer ID is printed by the seed on startup, `docker compose logs
# seed`).
REPAIR_INTERVAL=1h
SEED_ADDR=/dns4/seed/tcp/4001/p2p/xxxxxxxx
CAPACITY=0
LOGLEVEL=info
STORAGE_QUOTA=0
REBALANCE_INTERVAL=1h
REVIKA_PORT=4004
